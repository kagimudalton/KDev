<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    Tauri's default Windows manifest only declares the Common Controls v6
    dependency below. Without an explicit <compatibility> block, Windows
    falls back to legacy compatibility assumptions for the running process
    (this is what previously surfaced to users as a "Windows 8" style
    compatibility warning). Declaring the Windows 10/11 GUID tells Windows
    KDev is compatible with the current OS so it gets accurate
    GetVersion/DPI/feature behavior instead of a compatibility shim.
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

  <!--
    KDev must never require administrator rights for ordinary workspace
    operations (creating projects/files, switching languages, etc.). This
    keeps the process token at the user's normal privilege level; writable
    paths are handled separately in paths::kdev_root().
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
